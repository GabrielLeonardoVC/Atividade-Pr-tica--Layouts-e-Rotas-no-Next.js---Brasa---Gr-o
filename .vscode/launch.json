{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: debug servidor",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "runtimeExecutable": "node",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "action": "debugWithChrome",
        "killOnServerStop": true,
        "pattern": "- Local:.+(https?://.+) -"
      }
    },
    {
      "name": "Next.js: debug cliente",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000"
    },
    {
      "name": "Next.js: debug full stack",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "runtimeExecutable": "node",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "action": "debugWithChrome",
        "killOnServerStop": true,
        "pattern": "- Local:.+(https?://.+) -"
      }
    }
  ],
  "compounds": [
    {
      "name": "Next.js: debug completo",
      "configurations": ["Next.js: debug servidor", "Next.js: debug cliente"]
    }
  ]
}
